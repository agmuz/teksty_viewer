import 'dart:io';
import 'dart:async';
import 'dart:typed_data';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:pdfx/pdfx.dart';
import 'package:photo_view/photo_view.dart';
import 'package:path_provider/path_provider.dart';
import 'package:share_plus/share_plus.dart';
import 'package:dart_pdf_editor/dart_pdf_editor.dart' hide PdfDocument;
import '../utils/colors.dart';

class PdfViewerScreen extends StatefulWidget {
  final String filePath;
  final List<String> navigationList;
  final int currentIndex;
  final Future<void> Function(String newPath)? onFileChanged;

  const PdfViewerScreen({
    super.key,
    required this.filePath,
    required this.navigationList,
    required this.currentIndex,
    this.onFileChanged,
  });

  @override
  State<PdfViewerScreen> createState() => _PdfViewerScreenState();
}

class _PdfViewerScreenState extends State<PdfViewerScreen> {
  late PdfControllerPinch _controller;
  bool _appBarVisible = true;
  Timer? _hideTimer;
  late int _index;
  bool _annotationMode = false;
  Uint8List? _pdfBytes;

  static const double _swipeVelocity = 350.0;

  @override
  void initState() {
    super.initState();
    _index = widget.currentIndex;
    _controller = PdfControllerPinch(
      document: PdfDocument.openFile(widget.filePath),
    );

    // Fullscreen — ukryj WSZYSTKIE paski systemowe
    SystemChrome.setEnabledSystemUIMode(
      SystemUiMode.immersiveSticky,
    );

    // Ukryj AppBar po 3 sekundach
    _hideTimer = Timer(const Duration(seconds: 3), () {
      if (mounted) setState(() => _appBarVisible = false);
    });
  }

  @override
  void dispose() {
    // Przywróć paski systemowe po wyjściu z PDF
    SystemChrome.setEnabledSystemUIMode(
      SystemUiMode.manual,
      overlays: SystemUiOverlay.values,
    );
    _hideTimer?.cancel();
    _controller.dispose();
    super.dispose();
  }

  Future<void> _goTo(int newIndex) async {
    if (newIndex < 0 || newIndex >= widget.navigationList.length) return;
    if (newIndex == _index) return;
    final newPath = widget.navigationList[newIndex];
    final old = _controller;
    setState(() {
      _index = newIndex;
      _annotationMode = false;
      _pdfBytes = null;
      _controller = PdfControllerPinch(
        document: PdfDocument.openFile(newPath),
      );
    });
    await widget.onFileChanged?.call(newPath);
    await Future.delayed(const Duration(milliseconds: 120));
    old.dispose();
  }

  Future<void> _goPrev() => _goTo(_index - 1);
  Future<void> _goNext() => _goTo(_index + 1);

  String get _title {
    final p = widget.navigationList[_index];
    return p.split('/').last.replaceAll(RegExp(r'\.pdf$', caseSensitive: false), '');
  }

  bool get _hasPrev => _index > 0;
  bool get _hasNext => _index < widget.navigationList.length - 1;
  String get _currentPath => widget.navigationList[_index];

  Future<void> _openEditor() async {
    final f = File(_currentPath);
    _pdfBytes = await f.readAsBytes();
    setState(() => _annotationMode = true);
  }

  Future<void> _saveFromEditor(Uint8List bytes) async {
    try {
      final docs = await getApplicationDocumentsDirectory();
      final baseName = _currentPath.split('/').last
          .replaceAll(RegExp(r'\.pdf$', caseSensitive: false), '');
      final outDir = Directory('${docs.path}/teksty');
      if (!await outDir.exists()) {
        await outDir.create(recursive: true);
      }
      final outPath = '${outDir.path}/${baseName}_anns.pdf';
      final outFile = File(outPath);
      await outFile.writeAsBytes(bytes, flush: true);

      debugPrint('ANNOT saved: $outPath (${bytes.length} B)');

      if (!mounted) return;
      setState(() => _annotationMode = false);

      // Systemowy share sheet: Zapisz do plików / Drukuj / Wyślij
      await SharePlus.instance.share(
        ShareParams(
          files: [XFile(outPath, mimeType: 'application/pdf')],
          subject: baseName,
          text: 'Adnotacje do: $baseName',
        ),
      );
    } catch (e, st) {
      debugPrint('ANNOT save err: $e\n$st');
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Błąd zapisu: $e')),
      );
    }
  }

  void _showAppBarAndHideAfter3s() {
    _hideTimer?.cancel();
    setState(() => _appBarVisible = true);
    _hideTimer = Timer(const Duration(seconds: 3), () {
      if (mounted) setState(() => _appBarVisible = false);
    });
  }

  @override
  Widget build(BuildContext context) {
    final p = _currentPath.toLowerCase();
    final isImage = p.endsWith('.png') ||
        p.endsWith('.jpg') ||
        p.endsWith('.jpeg') ||
        p.endsWith('.webp') ||
        p.endsWith('.gif') ||
        p.endsWith('.bmp');
    final isText = p.endsWith('.txt') || p.endsWith('.md');

    return Scaffold(
      appBar: _appBarVisible
          ? AppBar(
        backgroundColor: AppColors.topBar,
        foregroundColor: Colors.white,
        toolbarHeight: 64,
        title: Text(
          _title,
          overflow: TextOverflow.ellipsis,
          style: const TextStyle(fontSize: 20, fontWeight: FontWeight.w600),
        ),
        leading: IconButton(
          iconSize: 32,
          padding: const EdgeInsets.all(8),
          icon: const Icon(Icons.arrow_back),
          tooltip: 'Lista',
          onPressed: () => Navigator.pop(context),
        ),
        actions: [
          if (!isImage && !isText)
            IconButton(
              iconSize: 28,
              tooltip: _annotationMode ? 'Wyłącz edycję' : 'Rysuj / Komentuj',
              icon: Icon(_annotationMode ? Icons.edit_off : Icons.edit_document),
              onPressed: _annotationMode
                  ? () => setState(() => _annotationMode = false)
                  : _openEditor,
            ),
          if (!_annotationMode) ...[
            IconButton(
              iconSize: 36,
              padding: const EdgeInsets.symmetric(horizontal: 12),
              icon: const Icon(Icons.arrow_back_ios_new),
              tooltip: 'Poprzedni',
              onPressed: _hasPrev ? _goPrev : null,
            ),
            Padding(
              padding: const EdgeInsets.symmetric(horizontal: 8),
              child: Center(
                child: Text(
                  '${_index + 1} / ${widget.navigationList.length}',
                  style: const TextStyle(
                    fontSize: 18,
                    fontWeight: FontWeight.w600,
                    color: Colors.white,
                  ),
                ),
              ),
            ),
            IconButton(
              iconSize: 36,
              padding: const EdgeInsets.symmetric(horizontal: 12),
              icon: const Icon(Icons.arrow_forward_ios),
              tooltip: 'Następny',
              onPressed: _hasNext ? _goNext : null,
            ),
          ],
        ],
      ) : null,
      body: isImage
          ? GestureDetector(
              behavior: HitTestBehavior.translucent,
              onTap: _showAppBarAndHideAfter3s,
              child: PhotoView(
                key: ValueKey(_index),
                imageProvider: FileImage(File(_currentPath)),
                minScale: PhotoViewComputedScale.contained,
                maxScale: PhotoViewComputedScale.covered * 3.0,
                initialScale: PhotoViewComputedScale.contained,
                backgroundDecoration: const BoxDecoration(color: Colors.black),
                loadingBuilder: (context, event) => const Center(
                  child: CircularProgressIndicator(),
                ),
                errorBuilder: (context, error, stackTrace) => Center(
                  child: Text(
                    'Nie można otworzyć obrazu:\n$error',
                    style: const TextStyle(color: Colors.white),
                  ),
                ),
              ),
            )
          : isText
              ? FutureBuilder<String>(
                  future: File(_currentPath).readAsString(),
                  builder: (context, snap) {
                    if (snap.connectionState != ConnectionState.done) {
                      return const Center(child: CircularProgressIndicator());
                    }
                    if (snap.hasError) {
                      return Center(
                        child: Text('Nie można odczytać pliku:\n${snap.error}'),
                      );
                    }
                    return SingleChildScrollView(
                      padding: const EdgeInsets.all(16),
                      child: SelectableText(
                        snap.data ?? '',
                        style: const TextStyle(
                          fontSize: 18,
                          height: 1.4,
                        ),
                      ),
                    );
                  },
                )
              : _annotationMode && _pdfBytes != null
          ? PdfEditorView(
              bytes: _pdfBytes!,
              onSave: _saveFromEditor,
              // Własny toolbar — od razu włącza rysik
              toolbarBuilder: (context, editing, viewer) {
                // Ustaw rysik jako domyślne narzędzie przy pierwszym buildzie
                editing.tool = PdfEditTool.ink;
                return BottomAppBar(
                  child: Row(
                    mainAxisAlignment: MainAxisAlignment.spaceEvenly,
                    children: [
                      IconButton(
                        icon: const Icon(Icons.edit),
                        tooltip: 'Rysik',
                        onPressed: () => editing.tool = PdfEditTool.ink,
                      ),
                      IconButton(
                        icon: const Icon(Icons.highlight),
                        tooltip: 'Zakreślacz',
                        onPressed: () => editing.tool = PdfEditTool.highlight,
                      ),
                      IconButton(
                        icon: const Icon(Icons.text_fields),
                        tooltip: 'Tekst',
                        onPressed: () => editing.tool = PdfEditTool.freeText,
                      ),
                      IconButton(
                        icon: const Icon(Icons.undo),
                        tooltip: 'Cofnij',
                        onPressed: () => editing.undo(),
                      ),
                      IconButton(
                        icon: const Icon(Icons.redo),
                        tooltip: 'Ponów',
                        onPressed: () => editing.redo(),
                      ),
                      IconButton(
                        icon: const Icon(Icons.save),
                        tooltip: 'Zapisz',
                        onPressed: () {
                          _saveFromEditor(editing.bytes);
                        },
                      ),
                    ],
                  ),
                );
              },
            )
          : Stack(
              children: [
                Positioned.fill(
                  child: PdfViewPinch(
                    key: ValueKey(_index),
                    controller: _controller,
                  ),
                ),
                if (!isImage)
                  Positioned.fill(
                    child: GestureDetector(
                      behavior: HitTestBehavior.translucent,
                      onHorizontalDragEnd: (details) {
                        final v = details.primaryVelocity ?? 0;
                        if (v <= -_swipeVelocity) {
                          _goNext();
                        } else if (v >= _swipeVelocity) {
                          _goPrev();
                        }
                      },
                      onTap: _showAppBarAndHideAfter3s,
                    ),
                  ),
              ],
            ),
    );
  }
}
